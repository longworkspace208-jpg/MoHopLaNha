NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=only-on-server
USDA_API_KEY=server-only-usda-key
ADMIN_PASSCODE=replace-with-a-strong-demo-passcode

# Cấu hình tài khoản ngân hàng nhận tiền chuyển khoản thủ công (server-only)
BANK_NAME=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_HOLDER=
PAYMENT_WINDOW_MIN=60

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis (Rate limiting)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Cloudflare Turnstile (Anti-bot CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
